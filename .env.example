# Optional phone mode. Keep disabled until sing-box >= 1.14 is installed.
MOMO_PHONE_MODE_ENABLED=0
MOMO_PHONE_24G_MAC=
MOMO_PHONE_24G_IP=
MOMO_RESIDENTIAL_SERVER=
MOMO_RESIDENTIAL_PORT=
MOMO_RESIDENTIAL_USERNAME=
MOMO_RESIDENTIAL_PASSWORD=

# Independent Zashboard selectors for each phone. Leave disabled until both
# phone identification and the router fail-closed firewall rules are verified.
MOMO_INDEPENDENT_PHONE_MODES=0
MOMO_OPPO_MAC=
MOMO_OPPO_IP=
# Optional JSON array for later devices: [{"id":"PHONE3","mac":"...","ip":"..."}]
MOMO_EXTRA_PHONES_JSON=
